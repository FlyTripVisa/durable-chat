interface Env {
  MY_BUCKET: R2Bucket;
  Chat: DurableObjectNamespace;
  ASSETS: Fetcher;
}

export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    // Put an object
    await env.MY_BUCKET.put("hello.txt", "Hello from R2!");

    // Get an object
    const obj = await env.MY_BUCKET.get("hello.txt");
    if (obj === null) {
      return new Response("Not found", { status: 404 });
    }
    return new Response(obj.body);
  },
};
